rules_version = '2';

// SportDrip Firestore rules.
//
// Principle: anything that affects the economy (balance, inventory, bets,
// prize boxes, ledger) is written ONLY by Cloud Functions using the Admin SDK,
// which bypasses these rules. The client is read-only on all of it.
//
// Deploy:  firebase deploy --only firestore:rules,firestore:indexes

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True if a friendship doc exists between the caller and uid.
    function isFriend(uid) {
      return signedIn() && exists(
        /databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))
      );
    }

    // Canonical, order-independent friendship id.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function onlyChanging(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowed);
    }

    // ---------------------------------------------------------------------
    // presence/{uid}: "online now" for friends. The owner writes only `at`.
    // ---------------------------------------------------------------------
    match /presence/{uid} {
      allow read: if isSelf(uid) || isFriend(uid);
      allow create, update: if isSelf(uid) &&
                            request.resource.data.keys().hasOnly(['at', 'gameId']) &&
                            request.resource.data.at is int &&
                            (!('gameId' in request.resource.data) || request.resource.data.gameId == null ||
                             (request.resource.data.gameId is string && request.resource.data.gameId.size() <= 64));
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;

      match /inventory/{itemId} {
        allow read: if isSelf(uid) || isFriend(uid);
        allow write: if false;
      }

      match /moves/{moveId} {
        allow read: if isSelf(uid) || isFriend(uid);
        allow write: if false;
      }

      match /backgrounds/{backgroundId} {
        allow read: if isSelf(uid) || isFriend(uid);
        allow write: if false;
      }

      // XP grant receipts (lib/xp.ts). Server-only.
      match /quests/{week} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /dailyPicks/{day} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Daily free bet tokens (placeFreeBet). Server-only.
      match /freeBets/{day} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /xpEvents/{eventId} {
        allow read, write: if false;
      }

      match /ledger/{entryId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /prizeBoxes/{tier} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                      request.resource.data.read is bool;
        allow create, delete: if false;
      }

      // Trophy shelf (champion, last place, lock hits, head-to-head titles).
      // Public status by design; written only by the server.
      match /trophies/{trophyId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Players this user blocked (callable/account.ts). Owner reads; server writes.
      match /blocks/{otherUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Private subdoc for anything that must not be visible to other users.
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Engagement push counter per local day (triggers/push.ts). Server-only.
      match /pushBudget/{day} {
        allow read, write: if false;
      }

      // Weekly social-quest counters (reactions). Server-only writes.
      match /questProgress/{week} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Season pass claim receipts (claimSeasonTier). Server-only writes.
      match /seasonClaims/{claimId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Drip Wrapped recaps. Owner reads; shared out via share cards, not rules.
      match /wrapped/{periodId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Live Activity push tokens, written through a callable.
      match /liveActivities/{gameId} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // usernames/{usernameLower} -> { uid }
    // ---------------------------------------------------------------------
    // Config docs (experiments, co-op rewards, ladder gate). Read-only to clients.
    match /meta/{docId} {
      allow read: if signedIn() && docId in ['experiments', 'coopRewards', 'ladder', 'achievementStats'];
      allow write: if false;
    }

    // Season pass definitions (item 20). Read-only to clients.
    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Bracket templates (item 21; content is live-ops).
    match /bracketTemplates/{templateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Weekly ladder cohorts (scheduled/ladder.ts). Signed-in read; server-only writes.
    match /ladderCohorts/{cohortId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // friendRequests/{fromUid_toUid}
    // ---------------------------------------------------------------------
    match /friendRequests/{reqId} {
      allow read: if signedIn() &&
                  (resource.data.from == request.auth.uid ||
                   resource.data.to == request.auth.uid);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // friendships/{pairId}
    // ---------------------------------------------------------------------
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // directMessages/{dm_<uidA>_<uidB>}/messages/{messageId}
    // Thread id is "dm_" + the two uids sorted. Only the two members read;
    // only friends write, as themselves; nothing is edited or deleted.
    // ---------------------------------------------------------------------
    function dmMembers(threadId) {
      return threadId.split('_');
    }

    function inDmThread(threadId) {
      let p = dmMembers(threadId);
      return signedIn() && p.size() == 3 && p[0] == 'dm' &&
             (p[1] == request.auth.uid || p[2] == request.auth.uid);
    }

    // friendLoans/{id}: credit loans between friends, outside leagues. Written only by
    // functions (callable/friendMoney.ts); the two parties read.
    match /friendLoans/{loanId} {
      allow read: if signedIn() && request.auth.uid in resource.data.parties;
      allow write: if false;
    }

    match /directMessages/{threadId}/messages/{messageId} {
      allow read: if inDmThread(threadId);
      allow create: if inDmThread(threadId) &&
                    messageId.size() <= 64 &&
                    request.resource.data.keys().hasOnly(['id', 'threadId', 'senderUid', 'senderName', 'recipientUid', 'recipientName', 'kind', 'text', 'at', 'replyTo', 'createdAt']) &&
                    request.resource.data.senderUid == request.auth.uid &&
                    request.resource.data.threadId == threadId &&
                    threadId == 'dm_' + pairId(request.auth.uid, request.resource.data.recipientUid) &&
                    isFriend(request.resource.data.recipientUid) &&
                    !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)/blocks/$(request.auth.uid)) &&
                    !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(request.resource.data.recipientUid)) &&
                    request.resource.data.kind == 'text' &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() >= 1 &&
                    request.resource.data.text.size() <= 500 &&
                    request.resource.data.at is int;
      // Reactions: either participant may set or clear only their own entry in `reactors`.
      allow update: if inDmThread(threadId) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactors']) &&
                    request.resource.data.reactors is map &&
                    request.resource.data.reactors.diff(resource.data.get('reactors', {})).affectedKeys().hasOnly([request.auth.uid]) &&
                    (!(request.auth.uid in request.resource.data.reactors) ||
                     request.resource.data.reactors[request.auth.uid] in ['🔥', '💀', '😂', '🧊', '🫡', '🤡']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // bets/{betId}
    // ---------------------------------------------------------------------
    match /bets/{betId} {
      allow get: if signedIn() &&
                 (resource.data.uid == request.auth.uid ||
                  isFriend(resource.data.uid));
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Flash picks (makeFlashPick). Server-written; players read their own.
    match /flashPicks/{pickId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Bet-slip parlays (placeParlay). Server-written.
    match /slipParlays/{parlayId} {
      allow get: if signedIn() &&
                 (resource.data.uid == request.auth.uid ||
                  isFriend(resource.data.uid));
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // challenges/{challengeId}
    // ---------------------------------------------------------------------
    match /challenges/{challengeId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // games/{gameId}
    // ---------------------------------------------------------------------
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Model-line team ratings (lib/ratings.ts). Server-written.
    match /ratings/{sport} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Daily Pick: the featured game is public; picks are server-written.
    match /sweat/{gameId} {
      allow read, write: if false;
    }

    match /dailyPick/{day} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // catalog/{itemId} & moves/{moveId}
    // ---------------------------------------------------------------------
    // Store lists mirrored into one doc each (functions/src/triggers/bundles.ts).
    match /bundles/{name} {
      allow read: if signedIn() && name in ['catalog', 'moves', 'backgrounds'];
      allow write: if false;
    }

    match /catalog/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /moves/{moveId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /backgrounds/{backgroundId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Invite codes -> uid. Looked up only through checkReferralCode / createProfile.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // leagues/{leagueId}
    // ---------------------------------------------------------------------
    function isLeagueMember(leagueId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds;
    }

    function leagueStartMs(leagueId) {
      let lg = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      return lg.get('startsAt', lg.get('createdAt', 0));
    }

    function memberDisplayName(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data.members[request.auth.uid].displayName;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      match /leagueBets/{betId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }
      match /loans/{loanId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }
      match /activity/{entryId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      // League chat. Members post text directly; bet cards and system rows
      // come from the server. The name must be the poster's league name,
      // reactions go through reactToItem, and nothing can be edited or deleted.
      match /messages/{messageId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if isLeagueMember(leagueId) &&
                      messageId.size() <= 64 &&
                      request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'text', 'at', 'createdAt', 'replyTo', 'reactions', 'reactors', 'gameId']) &&
                      (!('gameId' in request.resource.data) || (request.resource.data.gameId is string && request.resource.data.gameId.size() <= 64)) &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.name == memberDisplayName(leagueId) &&
                      request.resource.data.kind == 'text' &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() >= 1 &&
                      request.resource.data.text.size() <= 500 &&
                      request.resource.data.at is int &&
                      (!('reactions' in request.resource.data) || request.resource.data.reactions.size() == 0) &&
                      (!('reactors' in request.resource.data) || request.resource.data.reactors.size() == 0);
        allow update, delete: if false;
      }

      // Pre-season Bold Predictions: one per member, editable until the league starts.
      match /predictions/{uid} {
        allow read: if isLeagueMember(leagueId);
        allow create, update: if isLeagueMember(leagueId) &&
                              request.auth.uid == uid &&
                              request.time.toMillis() < leagueStartMs(leagueId) &&
                              request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at']) &&
                              request.resource.data.uid == uid &&
                              request.resource.data.name == memberDisplayName(leagueId) &&
                              request.resource.data.text is string &&
                              request.resource.data.text.size() >= 1 &&
                              request.resource.data.text.size() <= 140 &&
                              request.resource.data.at is int;
        allow delete: if false;
      }

      match /gameSides/{gameId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      // Co-op weekly goal (lib/coop.ts). Server-only writes.
      match /coop/{week} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      // Bracket picks (bracket mode). Members read; writes go through submitBracket.
      match /brackets/{memberUid} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /rivalries/{pairId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /reports/{week} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /matchups/{week} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /audit/{auditId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /picks/{pickId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /parlays/{parlayId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /bets/{betId} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // leagueInvites/{code}
    // ---------------------------------------------------------------------
    match /leagueInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // analyticsBatches/{batchId}: one write per flush, up to 50 events.
    // Write-only from the app; nothing reads it back or pays out from it.
    // ---------------------------------------------------------------------
    match /analyticsBatches/{batchId} {
      allow create: if signedIn() &&
                    batchId.size() <= 64 &&
                    request.resource.data.keys().hasOnly(['uid', 'at', 'platform', 'sessionId', 'schema', 'events']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.at == request.time &&
                    request.resource.data.platform is string &&
                    request.resource.data.platform.size() <= 16 &&
                    request.resource.data.sessionId is string &&
                    request.resource.data.sessionId.size() <= 32 &&
                    request.resource.data.events is list &&
                    request.resource.data.events.size() <= 50;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // analyticsEvents/{eventId}
    // ---------------------------------------------------------------------
    match /analyticsEvents/{eventId} {
      allow create: if signedIn() &&
                    eventId.size() <= 64 &&
                    request.resource.data.keys().hasOnly(['uid', 'name', 'params', 'clientAt', 'at', 'platform', 'sessionId', 'schema']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.name in [
                      'onboarding_completed', 'invite_code_captured', 'league_created', 'league_joined',
                      'bet_placed', 'bet_tailed', 'bet_faded', 'share_card_tapped',
                      'slip_opened', 'slip_stake_set', 'slip_confirmed', 'slip_error',
                      'share_completed', 'reaction_sent', 'prompt_shown', 'prompt_accepted',
                      'prompt_declined', 'daily_pick_made', 'quest_claimed', 'feed_item_tapped',
                      'tail_from_chat', 'activation_reached'
                    ] &&
                    request.resource.data.params is map &&
                    request.resource.data.params.size() <= 12 &&
                    request.resource.data.clientAt is int &&
                    request.resource.data.at == request.time &&
                    request.resource.data.platform is string &&
                    request.resource.data.platform.size() <= 16 &&
                    request.resource.data.sessionId is string &&
                    request.resource.data.sessionId.size() <= 32;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // betComments/{betId}/comments/{commentId}
    // Replies on a player's bet result / feed event. Authors post as
    // themselves under their profile name; nothing is edited or deleted.
    // ---------------------------------------------------------------------
    match /betComments/{betId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
                    commentId.size() <= 64 &&
                    request.resource.data.keys().hasOnly(['id', 'betId', 'uid', 'name', 'text', 'at', 'parentQuote', 'createdAt']) &&
                    request.resource.data.id == commentId &&
                    request.resource.data.betId == betId &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() >= 1 &&
                    request.resource.data.text.size() <= 500 &&
                    request.resource.data.at is int &&
                    request.resource.data.parentQuote is map;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
