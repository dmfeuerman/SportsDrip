+ * source bet, so the counters mean "how many people", not "how many taps".
+ */
+function followSource(
+  source: FirebaseFirestore.DocumentSnapshot,
+  kind: "tail" | "fade",
+  leagueId: string,
+  input: { gameId: string; side: "home" | "away" },
+  uid: string
