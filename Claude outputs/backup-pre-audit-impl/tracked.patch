+        const next = current + m.delta;
+        if (next < 0)
+            throw new https_1.HttpsError("failed-precondition", "Not enough credits.");
+        balances[m.uid] = next;
+        touched.add(m.uid);
+        rows.push({ ref: ledgerRefs[i], move: m, after: next });
+    });
