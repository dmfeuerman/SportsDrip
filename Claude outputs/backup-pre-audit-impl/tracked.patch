+  for (const u of touched) {
+    tx.update(db.collection("users").doc(u), { balance: balances[u], updatedAt: FieldValue.serverTimestamp() });
+  }
+  for (const { ref, move, after } of rows) {
+    tx.set(ref, {
+      type: move.type,
+      delta: move.delta,
+      balanceAfter: after,
+      ref: move.ref ?? null,
+      note: move.note ?? null,
+      createdAt: FieldValue.serverTimestamp(),
+    });
+  }
