+    return sorted.map((s, i) => {
+        const prev = sorted[i - 1];
+        if (prev && (pts(prev.uid) !== pts(s.uid) || prev.netWorth !== s.netWorth))
+            rank = i + 1;
+        return { ...s, rank };
+    });
