+    const nw = l.w + 8;
+    if (!placed.current || reduced) {
+      x.value = nx;
+      w.value = nw;
+      placed.current = true;
+    } else {
+      x.value = withSpring(nx, SPRING.snappy);
+      w.value = withSpring(nw, SPRING.snappy);
