+        ? `${me.displayName} voted to end the season early (${count}/${needed})`
+        : `${me.displayName} withdrew their early-end vote (${count}/${needed})`,
+    });
+
+    return { shouldFinalize: count >= needed, votes: count, needed };
+  });
+
