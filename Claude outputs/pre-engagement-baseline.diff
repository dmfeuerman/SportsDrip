+function rankByMode(standings, mode, h2h) {
+    if (mode !== "matchups")
+        return standings;
+    const pts = (uid) => {
+        const h = h2h(uid);
+        return (h?.w ?? 0) * 2 + (h?.t ?? 0);
+    };
+    const sorted = [...standings].sort((a, b) => pts(b.uid) - pts(a.uid) || b.netWorth - a.netWorth || (a.uid < b.uid ? -1 : 1));
