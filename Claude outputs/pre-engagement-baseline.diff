+export function calculateAgeFromDob(year: number, month: number, day: number): number {
+  const now = new Date();
+  let age = now.getFullYear() - year;
+  const m = now.getMonth() + 1 - month;
+  if (m < 0 || (m === 0 && now.getDate() < day)) {
+    age--;
+  }
+  return age;
+}
