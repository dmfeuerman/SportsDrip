# Copy to functions/.env (git-ignored) to enable the devTools callable used by
# the mobile app's dev launch flags (artifacts/mobile/scripts/dev-test.js).
# Leave DEV_TOOLS unset in production. The emulator enables it automatically.
DEV_TOOLS=1
# Comma-separated Firebase Auth uids allowed to use it (empty = any signed-in user).
DEV_TOOLS_UIDS=
