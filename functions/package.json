{
  "name": "sportdrip-functions",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 build-test/functions/test/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  }
}
